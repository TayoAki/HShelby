/* Composer */
"composer.placeholder" = "Message";
"composer.send" = "Send";
"composer.addPhoto" = "Add photo";
"composer.removePhoto" = "Remove photo";
/* %d: how many characters to remove */
"composer.tooLong" = "%d characters too long";
