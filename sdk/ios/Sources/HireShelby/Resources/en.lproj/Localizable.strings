/* Hire Shelby chat: English strings. Copy this folder as <language>.lproj to translate. Team messages and card
   button labels set in the dashboard are shown as written. */

/* Navigation title of the chat */
"chat.title" = "Support";
/* Shown when the app hasn't configured the SDK */
"chat.notConfigured" = "Support isn't available right now.";

/* Above an empty conversation */
"welcome.title" = "How can we help?";
"welcome.text" = "Send us a message and we'll answer here.";

"action.close" = "Close";
"action.retry" = "Retry";
"action.delete" = "Delete";
"action.copy" = "Copy";
