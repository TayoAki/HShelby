/* Delivery of the user's messages */
"status.sending" = "Sending…";
"status.sent" = "Sent";
"status.seen" = "Seen";
"status.notDelivered" = "Not delivered";
"status.tapToRetry" = "Not delivered. Tap to retry.";

/* %@: a teammate's first name */
"typing.named" = "%@ is typing…";
