{
  "name": "hshelby",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev:web": "npm run dev -w @hshelby/web",
    "dev:dashboard": "npm run dev -w @hshelby/dashboard",
    "dev:api": "npm run dev -w @hshelby/api",
    "dev:worker": "npm run dev -w @hshelby/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @hshelby/db",
    "db:migrate": "npm run migrate -w @hshelby/db"
  }
}
