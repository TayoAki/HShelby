{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @hshelby/api",
    "watchPatterns": ["/apps/api/**", "/packages/db/**", "/packages/core/**", "/packages/contracts/**", "/package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start -w @hshelby/api",
    "preDeployCommand": ["npm run migrate -w @hshelby/api"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
