# Copy to .env for local development (npm run dev:api). Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5433/hshelby_dev
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# "v1:" + openssl rand -base64 32
ENC_KEYS=
PUBLIC_API_URL=http://localhost:8080
# Stripe TEST mode only (sk_test_…). Billing stays off until all four are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Photos: any S3-compatible bucket. Photos stay off until endpoint, bucket and both keys are set.
# Local: moto_server -p 5070, then create the bucket (e.g. aws --endpoint-url http://127.0.0.1:5070 s3 mb s3://hshelby-local).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for endpoint/bucket/key URLs (moto, MinIO); Railway Buckets use virtual-hosted URLs
S3_FORCE_PATH_STYLE=
