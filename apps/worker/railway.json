{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @hshelby/worker",
    "watchPatterns": ["/apps/worker/**", "/packages/db/**", "/packages/core/**", "/package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start -w @hshelby/worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
