{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @hshelby/dashboard",
    "watchPatterns": ["/apps/dashboard/**", "/packages/ui/**", "/packages/contracts/**", "/package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start -w @hshelby/dashboard",
    "healthcheckPath": "/sign-in",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
